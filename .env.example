# Sidebar/browser-tab name. Defaults to "Open WebUI" upstream.
WEBUI_NAME='Idilio Chat'

# Required -- docker-compose.yaml fails fast if unset. Used both to seed
# the initial api.openai.com connection on first boot, and directly by
# openai/config/update on every later boot (this repo has no Ollama
# service -- OpenAI-compatible models only).
OPENAI_API_KEY=''

# Required -- docker-compose.yaml fails fast if unset. Generate with:
# python3 -c "import secrets; print(secrets.token_hex(32))"
WEBUI_SECRET_KEY=''

# Host port the container is published on (docker-compose.yaml maps this
# to the container's 8080). Leave unset for local dev (defaults to 3000);
# chat.idilio.tv's box sets this to 3003.
# OPEN_WEBUI_PORT=3000

# Used only by scripts/deploy.sh to sign in (or sign up, on a fresh
# instance) and re-run idilio-script-intelligence/openwebui/seed.py after
# every deploy. Not read by the app itself.
# DEPLOY_ADMIN_EMAIL='you@idilio.tv'
# DEPLOY_ADMIN_PASSWORD=''

# Lets users attach files from the company Google Drive via the "+" menu in
# chat. Needs a real OAuth 2.0 Web Client ID + API key from Google Cloud
# Console (Drive API + Picker API enabled, OAuth consent screen set to
# Internal so only @idilio.tv accounts can authorize) -- NOT the
# service-account JSON used elsewhere, which can't do the interactive
# per-user consent this requires.
ENABLE_GOOGLE_DRIVE_INTEGRATION=False
GOOGLE_DRIVE_CLIENT_ID=''
GOOGLE_DRIVE_API_KEY=''

# AUTOMATIC1111_BASE_URL="http://localhost:7860"

# For production, you should only need one host as
# fastapi serves the svelte-kit built frontend and backend from the same host and port.
# To test with CORS locally, you can set something like
# CORS_ALLOW_ORIGIN='http://localhost:5173;http://localhost:8080'
CORS_ALLOW_ORIGIN='*'

# Set to false to keep memory tools enabled without adding memory context to the system context.
ENABLE_MEMORY_SYSTEM_CONTEXT=true

# Set to false to disable workspace Tools and Functions.
ENABLE_PLUGINS=true

# For production you should set this to match the proxy configuration (127.0.0.1)
FORWARDED_ALLOW_IPS='*'

# DO NOT TRACK
SCARF_NO_ANALYTICS=true
DO_NOT_TRACK=true
ANONYMIZED_TELEMETRY=false

# Valkey Vector Store (requires VECTOR_DB=valkey)
# VALKEY_URL='valkey://localhost:6379'
# VALKEY_COLLECTION_PREFIX='open_webui'
# VALKEY_INDEX_TYPE='HNSW'
# VALKEY_DISTANCE_METRIC='COSINE'
# VALKEY_HNSW_M='16'
# VALKEY_HNSW_EF_CONSTRUCTION='200'
# VALKEY_HNSW_EF_RUNTIME='10'
